# Backend-only configuration template. Never put real secrets in this file.
GCP_PROJECT_ID=storelab-project-id
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
OIDC_COOKIE_SAME_SITE=none

GOOGLE_OIDC_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple is optional. Enable only after configuring a real HTTPS domain/Return URL.
APPLE_OIDC_ENABLED=false
APPLE_SERVICES_ID=
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY_PATH=C:/secure/path/AuthKey_XXXXXXXXXX.p8

GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/service-account.json
NOTIFICATION_API_URL=http://localhost:9999
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Keep OFF: avoids the known gRPC Firestore SDK/OpenTelemetry tracing conflict.
FIRESTORE_ENABLE_TRACING=OFF
